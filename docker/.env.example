# Copy to docker/.env (gitignored) and fill in. docker compose reads docker/.env automatically.
#
# Keycloak puts these into the realm's client secrets when it imports
# keycloak/secure-shop-realm.json. Any random string works for a fresh realm, e.g.
#   openssl rand -hex 32
# Use the same values in Postman (clientSecret) and when starting User Service
# (KEYCLOAK_ADMIN_CLIENT_SECRET).

KEYCLOAK_GATEWAY_CLIENT_SECRET=
KEYCLOAK_TEST_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
