          }
        },
        {
          "name": "Create Order - Insufficient Stock (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{orderServiceBaseUrl}}/orders",
              "host": [
                "{{orderServiceBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 100000\n}"
            }
          }
        },
        {
          "name": "Get Order - Another User's Order (404)",
          "description": "Place an order as one user, then re-run Auth > Get Token as a different user and fetch it by id: 404, not 403.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderServiceBaseUrl}}/orders/{{orderId}}",
              "host": [
                "{{orderServiceBaseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        }
      ],
      "description": "Orders belong to the sub in the token. GET /orders returns only the caller's orders, and another user's order responds 404 rather than 403 so its existence is not confirmed."
    },
