            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane R. Doe\",\n  \"address\": \"99 Other Street\",\n  \"username\": \"someone-else\",\n  \"email\": \"someone-else@example.com\"\n}"
            }
          }
        },
        {
          "name": "Delete My Profile (also deletes the Keycloak user)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{userServiceBaseUrl}}/users/me",
              "host": [
                "{{userServiceBaseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Register - Duplicate Username (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
