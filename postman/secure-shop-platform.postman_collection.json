    {
      "name": "User Service",
      "description": "POST /users/register is public — a new user has no token yet. Everything else is /users/me, resolved from the token's sub, so there is no id to tamper with. Run Auth > Get Token (registered user) after registering.",
      "item": [
        {
          "name": "Register (public, no token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceBaseUrl}}/users/register",
              "host": [
                "{{userServiceBaseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"fullName\": \"Jane Doe\",\n  \"address\": \"12 Example Road\",\n  \"phone\": \"0170000000\"\n}"
