            }
          }
        },
        {
          "name": "Update My Profile - username/email ignored (mass assignment)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceBaseUrl}}/users/me",
